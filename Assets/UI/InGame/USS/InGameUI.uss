@import url("../../Shared/Styles/DiegeticTheme.uss");

/* Root container for in-game HUD */
.hud-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* transparent over gameplay */
}

/* Generic small diegetic panel (top/bottom corners, etc.) */
.hud-panel {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
}

/* Character sheet panel */
.charsheet-panel {
    position: absolute;
    right: -568px; /* Start off-screen: -520px (width) - 48px (offset) */
    top: 72px;
    width: 520px;
    height: 800px;
    border-radius: var(--vtt-radius-large);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(12, 12, 16, 0.85);
    padding: 0;
    flex-direction: column;
}

.charsheet-title {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-title);
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-large);
}

.charsheet-text-main {
    color: var(--vtt-text-main);
    font-size: 16px;
}

.charsheet-text-muted {
    color: var(--vtt-text-muted);
    font-size: 16px;
}

/* Persistent Header Bar */
.charsheet-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.4);
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.portrait-button {
    width: 48px;
    height: 48px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.3);
    padding: 0;
    margin-right: var(--vtt-spacing-medium);
}

.portrait-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.header-info {
    flex-direction: column;
}

.header-name {
    color: var(--vtt-text-main);
    font-size: 16px;
    -unity-font-style: bold;
}

.header-details {
    color: var(--vtt-text-muted);
    font-size: 14px;
}

.header-center {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: center;
    margin-left: var(--vtt-spacing-large);
    margin-right: var(--vtt-spacing-large);
    flex-wrap: wrap;
}

.stat-container {
    flex-direction: column;
    align-items: center;
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    min-width: 60px;
}

.stat-container Label {
    white-space: nowrap;
    overflow: hidden;
}

.stat-label {
    color: var(--vtt-text-muted);
    font-size: 13px;
    margin-bottom: 4px;
}

.stat-value {
    color: var(--vtt-text-main);
    font-size: 16px;
    -unity-font-style: bold;
}

.hp-value {
    color: #4ade80; /* Green for HP */
    -unity-font-style: bold;
}

/* Rest Tab */
.rest-buttons-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.rest-buttons-container > * {
    margin-bottom: var(--vtt-spacing-large);
}

.rest-button-large {
    width: 80%;
    min-width: 200px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 18px;
    padding-left: var(--vtt-spacing-large);
    padding-right: var(--vtt-spacing-large);
    padding-top: var(--vtt-spacing-medium);
    padding-bottom: var(--vtt-spacing-medium);
    justify-content: center;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.rest-button-large:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.1;
}

/* Tab Navigation Carousel */
.charsheet-tabs-container {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.15);
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    overflow: hidden;
}

.charsheet-tabs-wrapper {
    flex-grow: 1;
    overflow: hidden;
}

.charsheet-tabs {
    flex-direction: row;
    overflow: visible;
    justify-content: space-around;
    align-items: center;
}

.tab-nav-button {
    background-color: transparent;
    border-width: 0;
    color: var(--vtt-text-muted);
    font-size: 24px;
    -unity-font-style: bold;
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    min-width: 32px;
    flex-shrink: 0;
    justify-content: center;
    -unity-text-align: middle-center;
}

.tab-nav-button:hover {
    color: var(--vtt-text-main);
    background-color: rgba(255, 255, 255, 0.05);
}

.tab-nav-button:disabled {
    opacity: 0.3;
}

.charsheet-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--vtt-text-muted);
    font-size: 16px;
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    flex: 1;
    min-width: 0;
    -unity-font-style: normal;
    transition-duration: 0.2s;
    transition-property: scale, color;
    justify-content: center;
    -unity-text-align: middle-center;
}

.charsheet-tab:hover {
    scale: 1.1;
}

.charsheet-tab:hover {
    color: var(--vtt-text-main);
    background-color: rgba(255, 255, 255, 0.03);
}

.charsheet-tab.active {
    color: var(--vtt-text-main);
    border-bottom-color: var(--vtt-accent-primary);
    -unity-font-style: bold;
}

/* Tab Content - Single ScrollView for all content */
.charsheet-tab-content {
    flex-grow: 1;
    overflow: scroll;
    min-height: 0;
}

.charsheet-tab-panel {
    padding: var(--vtt-spacing-large);
    display: none;
    flex-direction: column;
    min-height: 0;
    flex-shrink: 0;
}

.charsheet-tab-panel.active {
    display: flex;
}

/* Section Titles */
.section-title {
    color: var(--vtt-text-main);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-medium);
    margin-top: var(--vtt-spacing-medium);
}

/* Overview Tab */
.ability-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.ability-grid > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

.ability-score-button {
    width: 120px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small);
    justify-content: center;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.ability-score-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.1;
}

/* Skills Tab */
.skills-list {
    flex-direction: column;
}

.skills-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.charsheet-skill-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.charsheet-skill-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.charsheet-skill-button.proficient {
    border-color: var(--vtt-accent-primary);
    background-color: rgba(248, 213, 138, 0.1);
}

/* Actions Tab */
.actions-list {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-large);
}

.actions-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.action-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.attack-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.attack-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: #ef4444; /* Red for attacks */
    scale: 1.05;
}

/* Spells Tab */
.spell-slots-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.spell-slots-list > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

/* Inventory Tab */

.equipped-items {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-large);
}

.equipped-items > * {
    margin-bottom: var(--vtt-spacing-small);
}

.equipment-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.equipment-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-bottom: var(--vtt-spacing-large);
}

.inventory-grid > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

.inventory-slot {
    width: 56px;
    height: 56px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.25);
    justify-content: center;
    align-items: center;
}

.inventory-slot-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--vtt-text-main);
}

/* Features Tab */
.features-list {
    flex-direction: column;
}

.features-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.feature-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    flex-shrink: 0;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.feature-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}
