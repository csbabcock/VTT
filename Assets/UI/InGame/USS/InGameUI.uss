@import url("../../Shared/Styles/DiegeticTheme.uss");

/* Root container for in-game HUD */
.hud-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* transparent over gameplay */
}

/* Controls Cheat Sheet - anchored top-left */
.controls-cheatsheet-panel {
    position: absolute;
    left: 48px;
    top: 5px;
    width: 220px;
    border-radius: var(--vtt-radius-large);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(12, 12, 16, 0.85);
    padding: 0;
    flex-direction: column;
    overflow: hidden;
}

.controls-cheatsheet-header {
    flex-direction: row;
    align-items: center;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.4);
}

.controls-cheatsheet-title {
    color: var(--vtt-text-main);
    font-size: 18px;
    -unity-font-style: bold;
}

.controls-cheatsheet-content {
    flex-direction: column;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
}

.controls-cheatsheet-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--vtt-spacing-small);
    min-height: 24px;
}

.controls-cheatsheet-action {
    color: var(--vtt-text-main);
    font-size: 14px;
    flex-shrink: 0;
    margin-right: var(--vtt-spacing-medium);
}

.controls-cheatsheet-binding {
    color: var(--vtt-text-muted);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-small);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-width: 1px;
    border-color: var(--vtt-border-color);
}

/* Generic small diegetic panel (top/bottom corners, etc.) */
.hud-panel {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
}

/* Character sheet panel */
.charsheet-panel {
    position: absolute;
    right: 48px; /* Default visible position for editor preview */
    top: 5px; /* Same distance from top edge as game log spacing */
    width: 520px;
    height: 800px;
    border-radius: var(--vtt-radius-large);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(12, 12, 16, 0.85);
    padding: 0;
    flex-direction: column;
    overflow: hidden; /* Clip content to border-radius to prevent grey corners */
    display: flex; /* Visible by default for editor preview */
}

/* Runtime state: panel hidden off-screen (applied during play mode) */
.charsheet-panel.runtime-hidden {
    right: -568px; /* Off-screen position: -520px (width) - 48px (offset) */
    display: none;
}

.charsheet-title {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-title);
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-large);
}

.charsheet-text-main {
    color: var(--vtt-text-main);
    font-size: 16px;
}

.charsheet-text-muted {
    color: var(--vtt-text-muted);
    font-size: 16px;
}

/* Persistent Header Bar */
.charsheet-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.4);
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.portrait-button {
    width: 48px;
    height: 48px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.3);
    padding: 0;
    margin-right: var(--vtt-spacing-medium);
}

.portrait-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.header-info {
    flex-direction: column;
}

.header-name {
    color: var(--vtt-text-main);
    font-size: 16px;
    -unity-font-style: bold;
}

.header-details {
    color: var(--vtt-text-muted);
    font-size: 14px;
}

.header-center {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: center;
    margin-left: var(--vtt-spacing-large);
    margin-right: var(--vtt-spacing-large);
    flex-wrap: wrap;
}

.stat-container {
    flex-direction: column;
    align-items: center;
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    min-width: 60px;
}

.stat-container Label {
    white-space: nowrap;
    overflow: hidden;
}

.stat-label {
    color: var(--vtt-text-muted);
    font-size: 13px;
    margin-bottom: 4px;
}

.stat-value {
    color: var(--vtt-text-main);
    font-size: 16px;
    -unity-font-style: bold;
}

.move-button {
    margin-top: 4px;
    padding: 4px 8px;
    font-size: 12px;
    min-width: 50px;
    height: 24px;
    background-color: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
    border-width: 1px;
    border-radius: var(--vtt-radius-small);
    color: var(--vtt-text-main);
    transition-duration: 0.2s;
    transition-property: background-color, border-color;
}

.move-button:hover {
    background-color: rgba(59, 130, 246, 0.3);
    border-color: rgba(59, 130, 246, 0.7);
}

.move-button-active {
    background-color: rgba(239, 68, 68, 0.3) !important;
    border-color: rgba(239, 68, 68, 0.7) !important;
    -unity-font-style: bold;
}

.move-button-active:hover {
    background-color: rgba(239, 68, 68, 0.4) !important;
    border-color: rgba(239, 68, 68, 0.9) !important;
}

.movement-mode-active {
    border-width: 2px;
    border-color: rgba(59, 130, 246, 0.8);
    border-radius: var(--vtt-radius-small);
    padding: 2px;
    background-color: rgba(59, 130, 246, 0.1);
}

.hp-value {
    color: #4ade80; /* Green for HP */
    -unity-font-style: bold;
}

/* Rest Tab */
.rest-buttons-container {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
}

.rest-buttons-container > * {
    margin-bottom: var(--vtt-spacing-large);
}

.rest-button-large {
    width: 80%;
    min-width: 200px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 18px;
    padding-left: var(--vtt-spacing-large);
    padding-right: var(--vtt-spacing-large);
    padding-top: var(--vtt-spacing-medium);
    padding-bottom: var(--vtt-spacing-medium);
    justify-content: center;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.rest-button-large:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.1;
}

/* Tab Navigation Carousel */
.charsheet-tabs-container {
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.15);
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    overflow: hidden;
}

.charsheet-tabs-wrapper {
    flex-grow: 1;
    overflow: hidden;
}

.charsheet-tabs {
    flex-direction: row;
    overflow: visible;
    justify-content: space-around;
    align-items: center;
}

.tab-nav-button {
    background-color: transparent;
    border-width: 0;
    color: var(--vtt-text-muted);
    font-size: 24px;
    -unity-font-style: bold;
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    min-width: 32px;
    flex-shrink: 0;
    justify-content: center;
    -unity-text-align: middle-center;
}

.tab-nav-button:hover {
    color: var(--vtt-text-main);
    background-color: rgba(255, 255, 255, 0.05);
}

.tab-nav-button:disabled {
    opacity: 0.3;
}

.charsheet-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--vtt-text-muted);
    font-size: 16px;
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    flex: 1;
    min-width: 0;
    -unity-font-style: normal;
    transition-duration: 0.2s;
    transition-property: scale, color;
    justify-content: center;
    -unity-text-align: middle-center;
}

.charsheet-tab:hover {
    scale: 1.1;
}

.charsheet-tab:hover {
    color: var(--vtt-text-main);
    background-color: rgba(255, 255, 255, 0.03);
}

.charsheet-tab.active {
    color: var(--vtt-text-main);
    border-bottom-color: var(--vtt-accent-primary);
    -unity-font-style: bold;
}

/* Tab Content - Single ScrollView for all content */
.charsheet-tab-content {
    flex-grow: 1;
    overflow: scroll;
    min-height: 0;
}

.charsheet-tab-panel {
    padding: var(--vtt-spacing-large);
    display: none; /* Hidden by default */
    flex-direction: column;
    min-height: 0;
    flex-shrink: 0;
}

.charsheet-tab-panel.active {
    display: flex; /* Show active tab */
}

/* Section Titles */
.section-title {
    color: var(--vtt-text-main);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-medium);
    margin-top: var(--vtt-spacing-medium);
}

/* Overview Tab */
.ability-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
}

.ability-grid > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

.ability-score-button {
    width: 120px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small);
    justify-content: center;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.ability-score-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.1;
}

/* Skills Tab */
.skills-list {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-large);
}

.skills-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.charsheet-skill-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    align-items: center;
    flex-direction: row;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
    min-height: 32px;
}

.charsheet-skill-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.charsheet-skill-button.proficient {
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.3);
}

/* Skill icon - solid circle for proficient skills only */
.skill-icon {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--vtt-text-main);
    margin-right: var(--vtt-spacing-medium);
    flex-shrink: 0;
}

/* Spacer for non-proficient skills to align with proficient skills */
.skill-icon-spacer {
    width: 12px;
    height: 12px;
    margin-right: var(--vtt-spacing-medium);
    flex-shrink: 0;
}

.skill-ability {
    color: var(--vtt-text-main);
    font-size: 14px;
    min-width: 40px;
    margin-right: var(--vtt-spacing-medium);
    flex-shrink: 0;
}

.skill-name {
    color: var(--vtt-text-main);
    font-size: 16px;
    flex-grow: 1;
    margin-right: var(--vtt-spacing-medium);
}

.skill-modifier {
    color: var(--vtt-text-main);
    font-size: 16px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    min-width: 40px;
}

/* Actions Tab */
.actions-list {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-large);
}

.actions-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.action-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.attack-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.attack-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: #ef4444; /* Red for attacks */
    scale: 1.05;
}

/* Spells Tab */
.spell-slots-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.spell-slots-list > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

/* Inventory Tab */

.equipped-items {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-large);
}

.equipped-items > * {
    margin-bottom: var(--vtt-spacing-small);
}

.equipment-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.equipment-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-bottom: var(--vtt-spacing-large);
}

.inventory-grid > * {
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
}

.inventory-slot {
    width: 56px;
    height: 56px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.25);
    justify-content: center;
    align-items: center;
}

.inventory-slot-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--vtt-text-main);
}

/* Features Tab */
.features-list {
    flex-direction: column;
}

.features-list > * {
    margin-bottom: var(--vtt-spacing-small);
}

.feature-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 16px;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    flex-shrink: 0;
    transition-duration: 0.2s;
    transition-property: scale, background-color, border-color;
}

.feature-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
    scale: 1.05;
}

/* Keyboard Navigation - Selected Button Highlight */
.keyboard-selected {
    background-color: rgba(99, 102, 241, 0.3) !important; /* Indigo with transparency */
    border-color: var(--vtt-accent-primary) !important;
    border-width: 2px !important;
    scale: 1.05; /* Same scale as hover effect for most buttons */
}

.keyboard-selected:hover {
    background-color: rgba(99, 102, 241, 0.4) !important;
}

/* Ability score buttons use scale 1.1 on hover, so use that for keyboard selection too */
.ability-score-button.keyboard-selected {
    scale: 1.1;
}

/* Tab buttons use scale 1.1 on hover */
.charsheet-tab.keyboard-selected {
    scale: 1.1;
}

/* Game Log Panel */
.game-log-panel {
    position: absolute;
    right: 48px; /* Default visible position for editor preview */
    top: 815px; /* Positioned directly underneath character sheet (5px + 800px + 10px spacing) */
    width: 520px;
    height: 600px;
    min-height: 200px;
    max-height: 800px;
    border-radius: var(--vtt-radius-large);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(12, 12, 16, 0.85);
    padding: 0;
    flex-direction: column;
    overflow: hidden; /* Clip content to border-radius to prevent grey corners */
    display: flex; /* Visible by default for editor preview */
}

/* Runtime state: panel hidden off-screen (applied during play mode) */
.game-log-panel.runtime-hidden {
    right: -568px; /* Off-screen position: -520px (width) - 48px (offset) */
    display: none;
}

.game-log-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.4);
}

.game-log-title {
    color: var(--vtt-text-main);
    font-size: 18px;
    -unity-font-style: bold;
}

.game-log-clear-button {
    background-color: rgba(239, 68, 68, 0.2);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.4);
    border-radius: var(--vtt-radius-small);
    color: var(--vtt-text-main);
    font-size: 12px;
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    padding-top: 4px;
    padding-bottom: 4px;
    min-width: 50px;
    transition-duration: 0.2s;
    transition-property: background-color, border-color;
}

.game-log-clear-button:hover {
    background-color: rgba(239, 68, 68, 0.4);
    border-color: rgba(239, 68, 68, 0.7);
    color: #ffffff;
}

.game-log-content {
    flex-grow: 1;
    overflow: scroll;
    min-height: 0;
    padding: 0;
}

.game-log-entries {
    flex-direction: column;
    padding: var(--vtt-spacing-medium);
}

.game-log-entries > * {
    margin-bottom: var(--vtt-spacing-small);
}

/* Card-style log entry */
.game-log-card {
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: rgba(195, 224, 245, 0.3);
    padding: 0;
    margin-bottom: var(--vtt-spacing-small);
    flex-direction: column;
    overflow: hidden;
}

.game-log-card-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    padding-bottom: var(--vtt-spacing-small);
    border-bottom-width: 1px;
    border-bottom-color: rgba(195, 224, 245, 0.1);
    background-color: rgba(0, 0, 0, 0.2);
}

.game-log-delete-button {
    background-color: rgba(239, 68, 68, 0.2);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.4);
    border-radius: var(--vtt-radius-small);
    color: var(--vtt-text-main);
    font-size: 16px;
    -unity-font-style: bold;
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    margin: 0;
    transition-duration: 0.2s;
    transition-property: background-color, border-color, color;
}

.game-log-delete-button:hover {
    background-color: rgba(239, 68, 68, 0.4);
    border-color: rgba(239, 68, 68, 0.7);
    color: #ffffff;
}

/* Main content area */
.game-log-main-content {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    padding: var(--vtt-spacing-medium);
    padding-top: 0;
}

/* Character name - header style */
.game-log-character-name {
    color: var(--vtt-text-main);
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    flex-grow: 1;
}

.game-log-main-content > * {
    margin-bottom: 4px;
}

.game-log-main-content > .game-log-timestamp {
    margin-bottom: 0;
}

/* Action row */
.game-log-action-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.game-log-action-row > * {
    margin-right: var(--vtt-spacing-small);
}

.game-log-action-row > .game-log-sub-action {
    margin-right: 0;
}

.game-log-action-type {
    color: var(--vtt-text-main);
    font-size: 18px;
    -unity-font-style: bold;
}

.game-log-sub-action {
    font-size: 14px;
    -unity-font-style: bold;
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: 4px;
}

/* Sub-action colors */
.game-log-sub-action.sub-action-ability-check,
.game-log-sub-action.sub-action-skill {
    color: #d4a5f5;
    background-color: rgba(212, 165, 245, 0.15);
}

.game-log-sub-action.sub-action-attack,
.game-log-sub-action.sub-action-roll {
    color: #ffb366;
    background-color: rgba(255, 179, 102, 0.15);
}

.game-log-sub-action.sub-action-rest {
    color: #4ade80;
    background-color: rgba(74, 222, 128, 0.15);
}

/* Dice row */
.game-log-dice-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.game-log-dice-row > * {
    margin-right: var(--vtt-spacing-small);
}

.game-log-dice-row > .game-log-dice-formula {
    margin-right: 0;
}

.game-log-dice-breakdown {
    color: var(--vtt-text-main);
    font-size: 14px;
    margin-top: 2px;
}

.game-log-dice-formula {
    color: var(--vtt-text-muted);
    font-size: 14px;
    margin-top: 2px;
}

/* Result number */
.game-log-result {
    color: var(--vtt-text-main);
    font-size: 32px;
    -unity-font-style: bold;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Timestamp */
.game-log-timestamp {
    color: var(--vtt-text-muted);
    font-size: 11px;
    align-self: flex-end;
    margin-top: auto;
}

/* Legacy simple entry (for system messages) */
.game-log-entry {
    color: var(--vtt-text-main);
    font-size: 16px;
    margin-bottom: var(--vtt-spacing-small);
    white-space: normal;
    overflow: hidden;
}

/* Card border colors by type */
.game-log-card.log-ability-check {
    border-color: rgba(195, 224, 245, 0.4);
}

.game-log-card.log-skill {
    border-color: rgba(168, 230, 207, 0.4);
}

.game-log-card.log-attack {
    border-color: rgba(255, 179, 102, 0.4);
}

.game-log-card.log-attack-critical {
    border-color: rgba(74, 222, 128, 0.6);
    border-width: 2px;
}

.game-log-card.log-attack-miss,
.game-log-card.log-roll-critical-miss {
    border-color: rgba(239, 68, 68, 0.6);
    border-width: 2px;
}

.game-log-card.log-combat-action {
    border-color: rgba(248, 213, 138, 0.4);
}

.game-log-card.log-rest {
    border-color: rgba(212, 165, 245, 0.4);
}

.game-log-card.log-roll-critical {
    border-color: rgba(74, 222, 128, 0.6);
    border-width: 2px;
}

/* Result number colors */
.game-log-card.log-ability-check .game-log-result {
    color: #c3e0f5;
}

.game-log-card.log-skill .game-log-result {
    color: #a8e6cf;
}

.game-log-card.log-attack .game-log-result {
    color: #ffb366;
}

.game-log-card.log-attack-critical .game-log-result,
.game-log-card.log-roll-critical .game-log-result {
    color: #4ade80;
}

.game-log-card.log-attack-miss .game-log-result,
.game-log-card.log-roll-critical-miss .game-log-result {
    color: #ef4444;
}

/* Legacy simple entry styles (for system messages) */
.game-log-entry.log-system {
    color: var(--vtt-text-muted);
    font-size: 14px;
}
