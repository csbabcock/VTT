@import url("../../Shared/Styles/DiegeticTheme.uss");

/* Root container for in-game HUD */
.hud-root {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* transparent over gameplay */
}

/* Generic small diegetic panel (top/bottom corners, etc.) */
.hud-panel {
    background-color: rgba(0, 0, 0, 0.45);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
}

.charsheet-toggle-button {
    position: absolute;
    right: 40px;
    top: 16px;
}

/* Character sheet panel */
.charsheet-panel {
    position: absolute;
    right: 48px;
    top: 72px;
    width: 520px;
    min-height: 600px;
    border-radius: var(--vtt-radius-large);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: var(--vtt-bg-panel);
    padding: 0;
    flex-direction: column;
}

.charsheet-title {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-title);
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-large);
}

.charsheet-text-main {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
}

.charsheet-text-muted {
    color: var(--vtt-text-muted);
    font-size: var(--vtt-font-size-body);
}

/* Persistent Header Bar */
.charsheet-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: var(--vtt-spacing-medium) var(--vtt-spacing-large);
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.2);
}

.header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.portrait-button {
    width: 48px;
    height: 48px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.3);
    padding: 0;
    margin-right: var(--vtt-spacing-medium);
}

.portrait-image {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.header-info {
    flex-direction: column;
}

.header-name {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    -unity-font-style: bold;
}

.header-details {
    color: var(--vtt-text-muted);
    font-size: 12px;
}

.header-center {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: center;
    margin-left: var(--vtt-spacing-large);
    margin-right: var(--vtt-spacing-large);
}

.stat-container {
    flex-direction: column;
    align-items: center;
    margin-right: var(--vtt-spacing-large);
}

.stat-label {
    color: var(--vtt-text-muted);
    font-size: 11px;
    margin-bottom: 2px;
}

.stat-value {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    -unity-font-style: bold;
}

.hp-value {
    color: #4ade80; /* Green for HP */
}

.header-right {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.rest-button {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: 12px;
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    margin-left: var(--vtt-spacing-small);
}

.rest-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

/* Tab Navigation */
.charsheet-tabs {
    flex-direction: row;
    border-bottom-width: 1px;
    border-bottom-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.15);
    padding-left: var(--vtt-spacing-small);
    padding-right: var(--vtt-spacing-small);
}

.charsheet-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--vtt-text-muted);
    font-size: var(--vtt-font-size-body);
    padding-left: var(--vtt-spacing-medium);
    padding-right: var(--vtt-spacing-medium);
    padding-top: var(--vtt-spacing-small);
    padding-bottom: var(--vtt-spacing-small);
    margin-right: var(--vtt-spacing-small);
    -unity-font-style: normal;
}

.charsheet-tab:hover {
    color: var(--vtt-text-main);
    background-color: rgba(255, 255, 255, 0.03);
}

.charsheet-tab.active {
    color: var(--vtt-text-main);
    border-bottom-color: var(--vtt-accent-primary);
    -unity-font-style: bold;
}

/* Tab Content */
.charsheet-tab-content {
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}

.charsheet-tab-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: var(--vtt-spacing-large);
    overflow: scroll;
    display: none;
}

.charsheet-tab-panel.active {
    display: flex;
    flex-direction: column;
}

/* Section Titles */
.section-title {
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    -unity-font-style: bold;
    margin-bottom: var(--vtt-spacing-medium);
    margin-top: var(--vtt-spacing-medium);
}

/* Overview Tab */
.overview-main {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
}

.overview-section {
    flex-direction: column;
    flex: 1;
    margin-right: var(--vtt-spacing-large);
}

.ability-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.ability-score-button {
    width: 80px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small);
    margin-right: var(--vtt-spacing-small);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: center;
    -unity-text-align: middle-center;
}

.ability-score-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

.combat-stats-list {
    flex-direction: column;
    margin-bottom: var(--vtt-spacing-medium);
}

.collapsible-header {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    width: 100%;
}

.collapsible-header:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.collapsible-content {
    flex-direction: column;
    padding-left: var(--vtt-spacing-medium);
}

.save-throw-button {
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-small);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
    width: 100%;
}

.save-throw-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

/* Skills Tab */
.skills-main {
    flex-direction: column;
    flex-grow: 1;
}

.passive-skills {
    margin-bottom: var(--vtt-spacing-large);
}

.passive-skills-list {
    flex-direction: column;
}

.skills-section {
    flex-grow: 1;
    flex-direction: column;
}

.filter-toggle {
    margin-bottom: var(--vtt-spacing-medium);
}

.skills-scroll {
    flex-grow: 1;
}

.charsheet-skill-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
}

.charsheet-skill-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

.charsheet-skill-button.proficient {
    border-color: var(--vtt-accent-primary);
    background-color: rgba(248, 213, 138, 0.1);
}

/* Actions Tab */
.actions-main {
    flex-direction: column;
    flex-grow: 1;
}

.actions-section {
    margin-bottom: var(--vtt-spacing-large);
}

.actions-scroll {
    max-height: 200px;
}

.action-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

.attack-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
}

.attack-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: #ef4444; /* Red for attacks */
}

/* Spells Tab */
.spells-main {
    flex-direction: column;
    flex-grow: 1;
}

.spell-slots {
    margin-bottom: var(--vtt-spacing-large);
}

.spell-slots-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.spells-section {
    flex-grow: 1;
    flex-direction: column;
}

.spells-scroll {
    flex-grow: 1;
}

/* Inventory Tab */
.inventory-main {
    flex-direction: column;
    flex-grow: 1;
}

.inventory-section {
    margin-bottom: var(--vtt-spacing-large);
}

.equipped-items {
    flex-direction: column;
}

.equipment-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
}

.equipment-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.inventory-slot {
    width: 56px;
    height: 56px;
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    background-color: rgba(0, 0, 0, 0.25);
    margin-right: var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-medium);
    justify-content: center;
    align-items: center;
}

.inventory-slot-icon {
    width: 28px;
    height: 28px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--vtt-text-main);
}

.currency-list {
    flex-direction: row;
}

.currency-list Label {
    margin-right: var(--vtt-spacing-large);
}

/* Features Tab */
.features-main {
    flex-direction: column;
    flex-grow: 1;
}

.features-section {
    margin-bottom: var(--vtt-spacing-large);
}

.features-scroll {
    max-height: 250px;
}

.feature-button {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: var(--vtt-radius-medium);
    border-width: 1px;
    border-color: var(--vtt-border-color);
    color: var(--vtt-text-main);
    font-size: var(--vtt-font-size-body);
    padding: var(--vtt-spacing-small) var(--vtt-spacing-medium);
    margin-bottom: var(--vtt-spacing-small);
    justify-content: flex-start;
}

.feature-button:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: var(--vtt-accent-primary);
}
