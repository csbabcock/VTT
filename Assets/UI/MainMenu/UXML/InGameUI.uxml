<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/InGame/USS/InGameUI.uss?fileID=7433441132597879392&amp;guid=b2216ac57e27e33409a34847ef62657b&amp;type=3#InGameUI"/>
    <!-- Root HUD layer over gameplay -->
    <ui:VisualElement name="root" class="hud-root">
        <!-- Controls cheat sheet - anchored top-left -->
        <ui:VisualElement name="controls-cheatsheet-panel" class="controls-cheatsheet-panel diegetic-panel">
            <ui:VisualElement name="controls-cheatsheet-header" class="controls-cheatsheet-header">
                <ui:Label text="Controls" class="controls-cheatsheet-title" />
            </ui:VisualElement>
            <ui:VisualElement name="controls-cheatsheet-content" class="controls-cheatsheet-content">
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Move" class="controls-cheatsheet-action" />
                    <ui:Label text="WASD / Arrows" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Look" class="controls-cheatsheet-action" />
                    <ui:Label text="Mouse" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Jump" class="controls-cheatsheet-action" />
                    <ui:Label text="Space" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Sprint" class="controls-cheatsheet-action" />
                    <ui:Label text="Shift" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Perspective" class="controls-cheatsheet-action" />
                    <ui:Label text="V" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Encounter Mode" class="controls-cheatsheet-action" />
                    <ui:Label text="E" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Character Sheet" class="controls-cheatsheet-action" />
                    <ui:Label text="Tab" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Select Cell" class="controls-cheatsheet-action" />
                    <ui:Label text="Left Click" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
                <ui:VisualElement class="controls-cheatsheet-row">
                    <ui:Label text="Elevation" class="controls-cheatsheet-action" />
                    <ui:Label text="Scroll" class="controls-cheatsheet-binding" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- DM panel - host/DM only at runtime -->
        <ui:VisualElement name="dm-panel" class="dm-panel diegetic-panel">
            <ui:VisualElement name="dm-panel-header" class="dm-panel-header">
                <ui:Label text="Players" class="dm-panel-title" />
            </ui:VisualElement>
            <ui:ScrollView name="dm-player-list-scroll" class="dm-player-list-scroll">
                <ui:VisualElement name="dm-player-list" class="dm-player-list" />
            </ui:ScrollView>
            <ui:VisualElement name="dm-encounter-controls" class="dm-encounter-controls">
                <ui:Label text="Encounter" class="dm-encounter-title" />
                <ui:VisualElement class="dm-encounter-buttons">
                    <ui:Button name="dm-start-encounter-button" text="Start" class="dm-encounter-button" />
                    <ui:Button name="dm-end-encounter-button" text="End" class="dm-encounter-button" />
                    <ui:Button name="dm-next-turn-button" text="Next Turn" class="dm-encounter-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- DM character inspector - host/DM only at runtime -->
        <ui:VisualElement name="dm-inspector" class="dm-inspector diegetic-panel">
            <ui:Label name="dm-inspector-header" text="No player selected" class="dm-inspector-header" />
            <ui:VisualElement class="dm-inspector-section">
                <ui:Label text="Hit Points" class="dm-inspector-section-title" />
                <ui:Label name="dm-inspector-hp-value" text="—" class="dm-inspector-value" />
                <ui:VisualElement class="dm-inspector-controls">
                    <ui:Button name="dm-inspector-hp-minus-five" text="-5" class="dm-hp-button" />
                    <ui:Button name="dm-inspector-hp-minus-one" text="-1" class="dm-hp-button" />
                    <ui:Button name="dm-inspector-hp-plus-one" text="+1" class="dm-hp-button" />
                    <ui:Button name="dm-inspector-hp-plus-five" text="+5" class="dm-hp-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="dm-inspector-section">
                <ui:Label text="Temporary HP" class="dm-inspector-section-title" />
                <ui:Label name="dm-inspector-temp-hp-value" text="0" class="dm-inspector-value" />
                <ui:VisualElement class="dm-inspector-controls">
                    <ui:Button name="dm-inspector-temp-minus-one" text="-1" class="dm-hp-button" />
                    <ui:Button name="dm-inspector-temp-plus-one" text="+1" class="dm-hp-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="dm-inspector-section">
                <ui:Label text="Death Saves" class="dm-inspector-section-title" />
                <ui:VisualElement class="dm-death-save-row">
                    <ui:Label text="S" class="dm-death-save-label" />
                    <ui:VisualElement name="dm-inspector-death-successes" class="dm-death-save-pips" />
                </ui:VisualElement>
                <ui:VisualElement class="dm-death-save-row">
                    <ui:Label text="F" class="dm-death-save-label" />
                    <ui:VisualElement name="dm-inspector-death-failures" class="dm-death-save-pips" />
                </ui:VisualElement>
                <ui:Button name="dm-inspector-death-reset" text="Reset" class="dm-inspector-reset-button" />
            </ui:VisualElement>
            <ui:VisualElement class="dm-inspector-section">
                <ui:Label text="Conditions" class="dm-inspector-section-title" />
                <ui:VisualElement name="dm-inspector-condition-grid" class="dm-inspector-condition-grid" />
            </ui:VisualElement>
            <ui:VisualElement class="dm-inspector-section dm-inspector-status-row">
                <ui:Toggle name="dm-inspector-inspiration-toggle" label="Inspiration" class="dm-inspector-toggle" />
                <ui:VisualElement class="dm-inspector-exhaustion">
                    <ui:Label text="Exhaustion" class="dm-inspector-section-title" />
                    <ui:VisualElement class="dm-inspector-controls">
                        <ui:Button name="dm-inspector-exhaustion-minus" text="-" class="dm-hp-button" />
                        <ui:Label name="dm-inspector-exhaustion-value" text="0" class="dm-inspector-value" />
                        <ui:Button name="dm-inspector-exhaustion-plus" text="+" class="dm-hp-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Turn indicator - visible during networked encounters -->
        <ui:Label name="encounter-turn-label" text="" class="encounter-turn-label" />

        <!-- Character sheet panel; initially hidden by InGameUIView -->
        <ui:VisualElement name="character-sheet-panel" class="charsheet-panel diegetic-panel">
            <!-- Persistent Header Bar -->
            <ui:VisualElement name="charsheet-header" class="charsheet-header">
                <!-- Left: Portrait and Basic Info -->
                <ui:VisualElement name="header-left" class="header-left">
                    <ui:Button name="portrait-button" class="portrait-button">
                        <ui:VisualElement name="portrait-image" class="portrait-image" />
                    </ui:Button>
                    <ui:VisualElement name="header-info" class="header-info">
                        <ui:Label name="character-name" text="" class="header-name" />
                        <ui:Label name="character-details" text="—" class="header-details" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Center: Combat Stats -->
                <ui:VisualElement name="header-center" class="header-center">
                    <ui:VisualElement name="hp-container" class="stat-container">
                        <ui:Label text="HP" class="stat-label" />
                        <ui:Label name="hp-value" text="— / —" class="stat-value hp-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ac-container" class="stat-container">
                        <ui:Label text="AC" class="stat-label" />
                        <ui:Label name="ac-value" text="—" class="stat-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="initiative-container" class="stat-container">
                        <ui:Label text="Init" class="stat-label" />
                        <ui:Label name="initiative-value" text="—" class="stat-value" />
                    </ui:VisualElement>
                    <ui:VisualElement name="speed-container" class="stat-container">
                        <ui:Label text="Speed" class="stat-label" />
                        <ui:Label name="speed-value" text="— / — ft" class="stat-value" />
                        <ui:Button name="move-button" class="move-button" text="Move" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Tab Navigation Carousel -->
            <ui:VisualElement name="charsheet-tabs-container" class="charsheet-tabs-container">
                <ui:Button name="tab-nav-left" class="tab-nav-button" text="‹" />
                <ui:VisualElement name="charsheet-tabs-wrapper" class="charsheet-tabs-wrapper">
                    <ui:VisualElement name="charsheet-tabs" class="charsheet-tabs">
                        <ui:Button name="tab-overview" class="charsheet-tab active" text="Overview" />
                        <ui:Button name="tab-skills" class="charsheet-tab" text="Skills" />
                        <ui:Button name="tab-actions" class="charsheet-tab" text="Actions" />
                        <ui:Button name="tab-spells" class="charsheet-tab" text="Spells" />
                        <ui:Button name="tab-inventory" class="charsheet-tab" text="Inventory" />
                        <ui:Button name="tab-features" class="charsheet-tab" text="Features" />
                        <ui:Button name="tab-rest" class="charsheet-tab" text="Rest" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="tab-nav-right" class="tab-nav-button" text="›" />
            </ui:VisualElement>

            <!-- Tab Content Container - Single ScrollView for all content -->
            <ui:ScrollView name="charsheet-tab-content" class="charsheet-tab-content">
                <!-- TAB 0: Overview - All Content Combined -->
                <ui:VisualElement name="tab-overview-content" class="charsheet-tab-panel active">
                    <!-- Ability Scores -->
                    <ui:Label text="Ability Scores" class="section-title" />
                    <ui:VisualElement name="ability-grid" class="ability-grid">
                        <ui:Button name="ability-str" class="ability-score-button" text="STR —" />
                        <ui:Button name="ability-dex" class="ability-score-button" text="DEX —" />
                        <ui:Button name="ability-con" class="ability-score-button" text="CON —" />
                        <ui:Button name="ability-int" class="ability-score-button" text="INT —" />
                        <ui:Button name="ability-wis" class="ability-score-button" text="WIS —" />
                        <ui:Button name="ability-cha" class="ability-score-button" text="CHA —" />
                    </ui:VisualElement>

                    <!-- Skills -->
                    <ui:Label text="Skills" class="section-title" />
                    <ui:VisualElement name="skills-list" class="skills-list">
                        <ui:Button name="skill-acrobatics" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Acrobatics" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-animal-handling" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Animal Handling" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-arcana" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Arcana" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-athletics" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="STR" class="skill-ability" />
                            <ui:Label text="Athletics" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-deception" class="charsheet-skill-button proficient">
                            <ui:VisualElement class="skill-icon" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Deception" class="skill-name" />
                            <ui:Label text="+10" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-history" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="History" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-insight" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Insight" class="skill-name" />
                            <ui:Label text="+4" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-intimidation" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Intimidation" class="skill-name" />
                            <ui:Label text="+7" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-investigation" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Investigation" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-medicine" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Medicine" class="skill-name" />
                            <ui:Label text="+4" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-nature" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Nature" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-perception" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Perception" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-performance" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Performance" class="skill-name" />
                            <ui:Label text="+7" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-persuasion" class="charsheet-skill-button proficient">
                            <ui:VisualElement class="skill-icon" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Persuasion" class="skill-name" />
                            <ui:Label text="+10" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-religion" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Religion" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-sleight-of-hand" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Sleight of Hand" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-stealth" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Stealth" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-survival" class="charsheet-skill-button skill-last">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Survival" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                    </ui:VisualElement>

                    <!-- Actions & Attacks -->
                    <ui:Label text="Actions" class="section-title" />
                    <ui:VisualElement name="actions-list" class="actions-list">
                        <ui:Button name="action-attack" class="action-button" text="Attack" />
                        <ui:Button name="action-dash" class="action-button" text="Dash" />
                        <ui:Button name="action-disengage" class="action-button" text="Disengage" />
                        <ui:Button name="action-dodge" class="action-button" text="Dodge" />
                        <ui:Button name="action-help" class="action-button" text="Help" />
                        <ui:Button name="action-hide" class="action-button" text="Hide" />
                        <ui:Button name="action-ready" class="action-button" text="Ready" />
                        <ui:Button name="action-search" class="action-button" text="Search" />
                        <ui:Button name="action-use-object" class="action-button" text="Use Object" />
                    </ui:VisualElement>

                    <ui:Label text="Attacks" class="section-title" />
                    <ui:VisualElement name="attacks-list" class="actions-list">
                        <ui:Button name="attack-longsword" class="attack-button" text="Attack" />
                        <ui:Button name="attack-shortbow" class="attack-button" text="Attack" />
                    </ui:VisualElement>

                    <!-- Spells -->
                    <ui:Label text="Spell Slots" class="section-title" />
                    <ui:VisualElement name="spell-slots-list" class="spell-slots-list">
                        <ui:Label text="No spell slots (non-spellcaster)" class="charsheet-text-muted" />
                    </ui:VisualElement>

                    <!-- Inventory -->
                    <ui:Label text="Equipped" class="section-title" />
                    <ui:VisualElement name="equipped-items" class="equipped-items">
                        <ui:Button name="equipped-armor" class="equipment-button" text="Armor" />
                        <ui:Button name="equipped-weapon-1" class="equipment-button" text="Weapon" />
                        <ui:Button name="equipped-weapon-2" class="equipment-button" text="Weapon" />
                    </ui:VisualElement>

                    <ui:Label text="Carried Items" class="section-title" />
                    <ui:VisualElement name="inventory-grid" class="inventory-grid">
                        <!-- Placeholder inventory slots -->
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Features -->
                    <ui:Label text="Class Features" class="section-title" />
                    <ui:VisualElement name="features-list" class="features-list">
                        <ui:Button name="feature-fighting-style" class="feature-button" text="Class Feature" />
                        <ui:Button name="feature-second-wind" class="feature-button" text="Class Feature" />
                        <ui:Button name="feature-action-surge" class="feature-button" text="Class Feature" />
                    </ui:VisualElement>

                    <!-- Rest -->
                    <ui:Label text="Rest Options" class="section-title" />
                    <ui:VisualElement name="rest-buttons-container" class="rest-buttons-container">
                        <ui:Button name="short-rest-button" class="rest-button-large" text="Short Rest" />
                        <ui:Button name="long-rest-button" class="rest-button-large" text="Long Rest" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 1: Skills -->
                <ui:VisualElement name="tab-skills-content" class="charsheet-tab-panel">
                    <ui:Label text="Skills" class="section-title" />
                    <ui:VisualElement name="skills-list" class="skills-list">
                        <ui:Button name="skill-acrobatics" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Acrobatics" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-animal-handling" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Animal Handling" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-arcana" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Arcana" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-athletics" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="STR" class="skill-ability" />
                            <ui:Label text="Athletics" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-deception" class="charsheet-skill-button proficient">
                            <ui:VisualElement class="skill-icon" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Deception" class="skill-name" />
                            <ui:Label text="+10" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-history" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="History" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-insight" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Insight" class="skill-name" />
                            <ui:Label text="+4" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-intimidation" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Intimidation" class="skill-name" />
                            <ui:Label text="+7" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-investigation" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Investigation" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-medicine" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Medicine" class="skill-name" />
                            <ui:Label text="+4" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-nature" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Nature" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-perception" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Perception" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-performance" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Performance" class="skill-name" />
                            <ui:Label text="+7" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-persuasion" class="charsheet-skill-button proficient">
                            <ui:VisualElement class="skill-icon" />
                            <ui:Label text="CHA" class="skill-ability" />
                            <ui:Label text="Persuasion" class="skill-name" />
                            <ui:Label text="+10" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-religion" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="INT" class="skill-ability" />
                            <ui:Label text="Religion" class="skill-name" />
                            <ui:Label text="+0" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-sleight-of-hand" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Sleight of Hand" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-stealth" class="charsheet-skill-button">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="DEX" class="skill-ability" />
                            <ui:Label text="Stealth" class="skill-name" />
                            <ui:Label text="+6" class="skill-modifier" />
                        </ui:Button>
                        <ui:Button name="skill-survival" class="charsheet-skill-button skill-last">
                            <ui:VisualElement class="skill-icon-spacer" />
                            <ui:Label text="WIS" class="skill-ability" />
                            <ui:Label text="Survival" class="skill-name" />
                            <ui:Label text="+2" class="skill-modifier" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 2: Actions & Attacks -->
                <ui:VisualElement name="tab-actions-content" class="charsheet-tab-panel">
                    <ui:Label text="Actions" class="section-title" />
                    <ui:VisualElement name="actions-list" class="actions-list">
                        <ui:Button name="action-attack" class="action-button" text="Attack" />
                        <ui:Button name="action-dash" class="action-button" text="Dash" />
                        <ui:Button name="action-disengage" class="action-button" text="Disengage" />
                        <ui:Button name="action-dodge" class="action-button" text="Dodge" />
                        <ui:Button name="action-help" class="action-button" text="Help" />
                        <ui:Button name="action-hide" class="action-button" text="Hide" />
                        <ui:Button name="action-ready" class="action-button" text="Ready" />
                        <ui:Button name="action-search" class="action-button" text="Search" />
                        <ui:Button name="action-use-object" class="action-button" text="Use Object" />
                    </ui:VisualElement>

                    <ui:Label text="Attacks" class="section-title" />
                    <ui:VisualElement name="attacks-list" class="actions-list">
                        <ui:Button name="attack-longsword" class="attack-button" text="Attack" />
                        <ui:Button name="attack-shortbow" class="attack-button" text="Attack" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 3: Spells -->
                <ui:VisualElement name="tab-spells-content" class="charsheet-tab-panel">
                    <ui:Label text="Spell Slots" class="section-title" />
                    <ui:VisualElement name="spell-slots-list" class="spell-slots-list">
                        <ui:Label text="No spell slots (non-spellcaster)" class="charsheet-text-muted" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 4: Inventory -->
                <ui:VisualElement name="tab-inventory-content" class="charsheet-tab-panel">
                    <ui:Label text="Equipped" class="section-title" />
                    <ui:VisualElement name="equipped-items" class="equipped-items">
                        <ui:Button name="equipped-armor" class="equipment-button" text="Armor" />
                        <ui:Button name="equipped-weapon-1" class="equipment-button" text="Weapon" />
                        <ui:Button name="equipped-weapon-2" class="equipment-button" text="Weapon" />
                    </ui:VisualElement>

                    <ui:Label text="Carried Items" class="section-title" />
                    <ui:VisualElement name="inventory-grid" class="inventory-grid">
                        <!-- Placeholder inventory slots -->
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                        <ui:VisualElement class="inventory-slot">
                            <ui:VisualElement class="inventory-slot-icon" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 5: Features -->
                <ui:VisualElement name="tab-features-content" class="charsheet-tab-panel">
                    <ui:Label text="Class Features" class="section-title" />
                    <ui:VisualElement name="features-list" class="features-list">
                        <ui:Button name="feature-fighting-style" class="feature-button" text="Class Feature" />
                        <ui:Button name="feature-second-wind" class="feature-button" text="Class Feature" />
                        <ui:Button name="feature-action-surge" class="feature-button" text="Class Feature" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- TAB 6: Rest -->
                <ui:VisualElement name="tab-rest-content" class="charsheet-tab-panel">
                    <ui:Label text="Rest Options" class="section-title" />
                    <ui:VisualElement name="rest-buttons-container" class="rest-buttons-container">
                        <ui:Button name="short-rest-button" class="rest-button-large" text="Short Rest" />
                        <ui:Button name="long-rest-button" class="rest-button-large" text="Long Rest" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>

        <!-- Game log panel; positioned underneath character sheet -->
        <ui:VisualElement name="game-log-panel" class="game-log-panel diegetic-panel">
            <!-- Header -->
            <ui:VisualElement name="game-log-header" class="game-log-header">
                <ui:Label text="Game Log" class="game-log-title" />
                <ui:Button name="game-log-clear-button" class="game-log-clear-button" text="Clear" />
            </ui:VisualElement>

            <!-- Scrollable log content -->
            <ui:ScrollView name="game-log-content" class="game-log-content">
                <ui:VisualElement name="game-log-entries" class="game-log-entries">
                    <!-- Log entries will be added dynamically -->
                    <ui:Label text="[System] Game log initialized" class="game-log-entry log-system" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
