@import url("MainMenuView.uss");

/* Root container - full screen */
.character-creation-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.85);
    padding: 0;
}

/* Fills viewport between root and action bar; nested panes scroll independently */
.character-creation-content-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: column;
    width: 100%;
}

/* Main container: constrained row so child columns can shrink and inner ScrollViews receive height */
.character-creation-container {
    flex-direction: row;
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    align-items: stretch;
    background-color: var(--color-bg-primary);
    border-radius: 0;
    border-width: 0;
    border-color: var(--color-border-strong);
    padding: 20px;
}

/* MainMenu-style inner scroll regions (class/race/background, detail body, stats, proficiencies) */
.character-creation-options-scroll,
.character-creation-detail-scroll,
.character-creation-stats-scroll,
.character-creation-proficiency-scroll {
    width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

/* Row: ScrollView + authorable track (native vertical scroller is Hidden in UXML). */
.character-creation-scroll-with-custom-bar {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    align-items: stretch;
}

.character-creation-scroll-with-custom-bar > .character-creation-pane-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: auto;
}

/* ScrollView must clip: viewport grows in flex, content sizes to children — without min-height: 0 the view expands and never scrolls (maxScroll stays 0). */
.character-creation-pane-scroll.unity-scroll-view--vertical {
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.character-creation-pane-scroll .unity-scroll-view__content-viewport--vertical {
    flex-grow: 1;
    min-height: 0;
}

.character-creation-custom-vscroll-track {
    width: 20px;
    min-width: 20px;
    flex-shrink: 0;
    flex-grow: 0;
    align-self: stretch;
    /* 6px from scroll pane matches horizontal breathing room; vertical inset matches thumb left/right (2px) via padding. */
    margin-left: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
    position: relative;
    padding-top: 2px;
    padding-bottom: 2px;
    /* Darker trough than panel cards; thumb reads as a slightly lighter chip */
    background-color: var(--color-bg-primary);
    border-width: 1px;
    border-color: var(--color-border-default);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.character-creation-custom-vscroll-thumb {
    position: absolute;
    left: 2px;
    right: 2px;
    min-height: 28px;
    border-radius: 2px;
    background-color: var(--color-border-default);
    border-width: 0;
    transition-duration: var(--transition-fast);
    transition-property: background-color;
}

.character-creation-custom-vscroll-thumb:hover {
    background-color: var(--color-border-strong);
}

.character-creation-custom-vscroll-thumb:active {
    background-color: var(--color-blue-25);
}

.character-creation-stats-scroll-content {
    flex-direction: column;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    flex-grow: 0;
    /* Match ability tiles / pool: symmetric inset only (no horizontal margin). */
    padding: 8px;
}

.character-creation-container > * {
    margin-right: 24px;
}

/* Left Panel */
.character-creation-left-panel {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 400px;
    min-height: 0;
}

.character-creation-left-panel > * {
    margin-bottom: 20px;
}

/* ~45% of left column: class/race/background + tabs */
.character-creation-main-content {
    background-color: var(--color-bg-secondary);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 25px;
    flex-direction: column;
    flex-grow: 9;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.character-creation-level-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.character-creation-level-row > * {
    margin-right: 10px;
}

.character-creation-level-label {
    color: var(--color-text-n2);
    font-size: 14px;
    -unity-font-style: bold;
    min-width: 110px;
}

.character-creation-level-step-button {
    min-width: 36px;
    height: 32px;
    padding: 4px 8px;
    font-size: 18px;
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-strong);
    background-color: var(--color-bg-shade1);
    color: var(--color-text-primary);
}

.character-creation-level-field {
    width: 72px;
    min-width: 72px;
    flex-shrink: 0;
}

.character-creation-level-hint {
    color: var(--color-text-n3);
    font-size: 12px;
}

.character-creation-title {
    color: var(--color-blue);
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 25px;
    -unity-text-align: middle-center;
    letter-spacing: -0.96px;
}

/* Tabs Container */
.character-creation-tabs-container {
    flex-direction: row;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    padding-bottom: 0;
    flex-shrink: 0;
}

.character-creation-tab {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    color: var(--color-text-n3);
    font-size: 15px;
    padding: 12px 20px;
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 0;
    -unity-font-style: normal;
    transition-duration: var(--transition-fast);
    transition-property: color, border-bottom-color;
    justify-content: center;
    -unity-text-align: middle-center;
    letter-spacing: -0.3px;
}

.character-creation-tab:hover {
    color: var(--color-text-primary);
    background-color: var(--color-bg-shade1);
}

.character-creation-tab.active {
    color: var(--color-blue);
    border-bottom-color: var(--color-blue);
    -unity-font-style: bold;
}

.character-creation-tab-content-container {
    flex-grow: 1;
    min-height: 0;
    position: relative;
}

.character-creation-tab-content {
    display: none;
    flex-grow: 1;
    min-height: 0;
}

.character-creation-tab-content.active {
    display: flex;
    flex-direction: column;
}

/* Wrapping tile grid (matches ability-row chip spacing ~12px) */
.character-creation-buttons-container {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    width: 100%;
    padding-bottom: var(--spacing-sm);
}

.character-creation-buttons-container > * {
    margin-right: 12px;
    margin-bottom: 12px;
}

.character-creation-option-button {
    min-width: 132px;
    max-width: 200px;
    width: auto;
    flex-grow: 0;
    flex-shrink: 0;
    height: 52px;
    min-height: 52px;
    background-color: var(--color-bg-secondary);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-strong);
    color: var(--color-text-n3);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: -0.28px;
    padding: var(--spacing-sm) var(--spacing-md);
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
    white-space: normal;

    transition-duration: var(--transition-fast);
    transition-property: background-color, border-color, color;
}

.character-creation-option-button:hover {
    background-color: var(--color-bg-shade1);
    border-color: var(--color-blue);
    border-width: 2px;
    color: var(--color-text-primary);
}

.character-creation-option-button.selected {
    background-color: var(--color-bg-shade1);
    border-width: 2px;
    border-color: var(--color-blue);
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.character-creation-score-method-buttons {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 12px;
    margin-bottom: 8px;
}

.character-creation-score-method-buttons > .character-creation-roll-button {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 72px;
    margin-right: 6px;
}

.character-creation-roll-button {
    width: 100%;
    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border-width: 2px;
    border-color: var(--color-border-strong);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
    letter-spacing: -0.26px;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color;
}

.character-creation-roll-button:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
}

.character-creation-roll-button.selected {
    border-color: var(--color-blue);
    border-width: 2px;
}

.character-creation-confirm-scores-button {
    width: 100%;
    background-color: var(--color-bg-secondary);
    border-width: 2px;
    border-color: var(--color-blue);
    color: var(--color-blue);
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 12px;
    letter-spacing: -0.26px;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color, color;
}

.character-creation-confirm-scores-button:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
    color: var(--color-text-primary);
}

/* ~55% of left column: sticky header + scrollable body */
.character-creation-detail-panel {
    background-color: var(--color-bg-secondary);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 30px;
    flex-direction: column;
    flex-grow: 11;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.character-creation-detail-title {
    flex-shrink: 0;
    color: var(--color-blue);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    padding-bottom: 12px;
    letter-spacing: -0.8px;
}

.character-creation-detail-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    flex-shrink: 0;
}

.character-creation-detail-header > * {
    margin-right: 15px;
}

.character-creation-detail-icon {
    width: 60px;
    height: 60px;
    background-color: var(--color-bg-shade1);
    border-radius: 50%;
    justify-content: center;
    align-items: center;
    font-size: 30px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: var(--color-border-strong);
}

.character-creation-detail-title-container {
    flex-grow: 1;
    flex-direction: column;
}

.character-creation-detail-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-blue);
    margin-bottom: 4px;
    letter-spacing: -0.96px;
}

.character-creation-detail-type {
    font-size: 14px;
    color: var(--color-text-n3);
    letter-spacing: -0.28px;
}

.character-creation-detail-content-wrapper {
    flex-direction: column;
}

.character-creation-detail-sections-host {
    flex-direction: column;
    margin-bottom: 8px;
}

.character-creation-detail-section-heading {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-top: 18px;
    margin-bottom: 8px;
    letter-spacing: -0.34px;
    white-space: normal;
}

.character-creation-detail-section-body {
    color: var(--color-text-n2);
    font-size: 15px;
    margin-bottom: 14px;
    white-space: normal;
    letter-spacing: -0.3px;
}

/* Live ability substitution: draws the eye to rules using current scores */
.character-creation-live-ability-hint {
    background-color: rgba(2, 190, 250, 0.09);
    border-left-width: 3px;
    border-left-color: var(--color-blue);
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    margin-top: 2px;
    margin-bottom: 4px;
}

.character-creation-detail-section-heading--live-stats {
    color: var(--color-teal);
}

.character-creation-detail-quick-build {
    flex-direction: column;
    background-color: var(--color-bg-shade1);
    border-left-width: 3px;
    border-left-color: var(--color-blue);
    padding: 14px 16px;
    margin-bottom: 16px;
    border-radius: var(--radius-sm);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--color-border-default);
    border-right-color: var(--color-border-default);
    border-bottom-color: var(--color-border-default);
}

.character-creation-detail-quick-build--live-stats {
    background-color: rgba(2, 190, 250, 0.1);
    border-left-color: var(--color-teal);
}

.character-creation-detail-quick-build-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-blue);
    margin-bottom: 8px;
    letter-spacing: -0.28px;
}

.character-creation-detail-content {
    color: var(--color-text-n2);
    font-size: 15px;
    margin-bottom: 20px;
    white-space: normal;
    letter-spacing: -0.3px;
}

.character-creation-features-section {
    margin-top: 20px;
}

.character-creation-features-title {
    color: var(--color-text-n2);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    margin-top: 20px;
    letter-spacing: -0.32px;
}

.character-creation-feature-item {
    background-color: var(--color-bg-shade1);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-default);
    padding: 15px;
    margin-bottom: 12px;
}

.character-creation-feature-item--live-stats {
    border-color: var(--color-blue);
    border-left-width: 3px;
    border-left-color: var(--color-blue);
}

.character-creation-feature-name {
    color: var(--color-blue);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: -0.3px;
}

.character-creation-feature-description {
    color: var(--color-text-n2);
    font-size: 14px;
    white-space: normal;
    letter-spacing: -0.28px;
}

/* Right Panel */
.character-creation-right-panel {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 400px;
    min-height: 0;
}

.character-creation-right-panel > * {
    margin-bottom: 20px;
}

/* ~65% of right column */
.character-creation-stats-panel {
    background-color: var(--color-bg-secondary);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 24px;
    flex-direction: column;
    flex-grow: 13;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
    min-width: 0;
    align-items: stretch;
}

/* Ensure the stats ScrollView row always receives the remaining height under the title */
.character-creation-stats-panel > .character-creation-scroll-with-custom-bar {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.character-creation-stats-title {
    flex-shrink: 0;
    color: var(--color-blue);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    padding-bottom: 10px;
    letter-spacing: -0.72px;
}

/* Rolled Scores Pool */
.character-creation-rolled-scores-pool {
    margin-bottom: 14px;
    padding: 12px;
    background-color: var(--color-bg-shade1);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-default);
}

.character-creation-rolled-scores-title {
    color: var(--color-text-n2);
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    letter-spacing: -0.26px;
}

/* Point Buy: available points display in pool */
.character-creation-point-buy-points {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 6px;
}

/* Two equal halves; [−][score][+] centered in left half, mod centered in right (headers match in label row). */
.character-creation-ability-score-value-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 1;
    flex-wrap: nowrap;
    width: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.character-creation-ability-stat-value-half--score {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.character-creation-ability-stat-value-half--mod {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

/* 55.32% of half width == 27.66% of full tile — same compact score/mod cell size as before the split. */
.character-creation-ability-stat-value-half--score .character-creation-point-buy-controls {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 0;
    margin-right: 0;
}

.character-creation-ability-stat-value-half--score .character-creation-point-buy-controls--before-mod {
    margin-right: 0;
}

/* Drop zone and manual TextField stack (absolute) so toggling does not change slot size. */
.character-creation-ability-score-input-slot {
    position: relative;
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 55.32%;
    min-width: 28px;
    width: auto;
    height: 36px;
    min-height: 26px;
    margin-left: 4px;
    margin-right: 4px;
}

.character-creation-ability-score-input-slot > .character-creation-ability-score-drop-zone,
.character-creation-ability-score-input-slot > .character-creation-ability-score-entry-field {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.character-creation-ability-stat-value-half--mod .character-creation-ability-mod-box {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: 55.32%;
    min-width: 28px;
    width: auto;
    height: 36px;
    min-height: 26px;
    margin-right: 0;
}

.character-creation-point-buy-controls {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 1;
    min-width: 0;
    -unity-text-align: middle-center;
}

.character-creation-point-buy-btn {
    min-width: 18px;
    width: 36px;
    max-width: 100%;
    height: 36px;
    max-height: 100%;
    min-height: 22px;
    flex-shrink: 1;
    padding: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;

    background-color: var(--color-bg-secondary);
    color: var(--color-text-primary);
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);

    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color, color;
}

.character-creation-point-buy-btn:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
    color: var(--color-text-primary);
}

.character-creation-point-buy-btn:active {
    background-color: var(--color-bg-shade1);
    border-color: var(--color-blue);
}

.character-creation-point-buy-btn.disabled {
    color: var(--color-text-n4);
    border-color: var(--color-border-subtle);
    background-color: var(--color-bg-shade1);
}

.character-creation-rolled-scores-container {
    flex-direction: row;
    flex-wrap: nowrap;
    min-height: 52px;
    align-items: center;
}

.character-creation-rolled-scores-container > * {
    margin-right: 14px;
    margin-bottom: 0;
}

.character-creation-rolled-scores-container.drag-over {
    border-width: 2px;
    border-color: var(--color-blue);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-shade1);
}

.character-creation-rolled-score-item {
    flex-direction: row;
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background-color: var(--color-bg-primary);
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    justify-content: center;
    align-items: center;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color, opacity;
}

.character-creation-rolled-score-item:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
}

.character-creation-rolled-score-item.dragging {
    opacity: 0.5;
}

.character-creation-rolled-score-item.drag-preview {
    opacity: 0.9;
}

.character-creation-rolled-score-item.assigned {
    opacity: 0.4;
    border-color: var(--color-border-default);
    background-color: var(--color-bg-shade1);
}

/* Roll option: score centered above its 4 die chips, no outer border; compact to fit one line */
.character-creation-rolled-score-item--with-dice {
    flex-direction: column;
    align-items: center;
    width: 72px;
    min-width: 72px;
    flex-shrink: 0;
    height: auto;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

/* Score container stays fixed height, centered above dice row */
.character-creation-rolled-score-value-box {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    background-color: var(--color-bg-primary);
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    justify-content: center;
    align-items: center;
}

.character-creation-rolled-score-item--with-dice:hover .character-creation-rolled-score-value-box {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
}

.character-creation-rolled-score-item--with-dice.dragging .character-creation-rolled-score-value-box {
    opacity: 0.5;
}

.character-creation-rolled-score-item--with-dice.assigned .character-creation-rolled-score-value-box {
    opacity: 0.4;
    border-color: var(--color-border-default);
    background-color: var(--color-bg-shade1);
}

.character-creation-rolled-score-dice-row {
    flex-direction: row;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
}

.character-creation-rolled-score-dice-row > * {
    margin-right: 2px;
}

.character-creation-rolled-score-die-chip {
    width: 16px;
    height: 18px;
    min-width: 16px;
    min-height: 18px;
    background-color: var(--color-bg-shade1);
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: 3px;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
}

.character-creation-rolled-score-die-chip-dropped {
    color: var(--color-text-n4);
    opacity: 0.7;
}

.character-creation-rolled-score-die-chip-kept {
    color: var(--color-text-primary);
}

.character-creation-rolled-score-value {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-blue);
    letter-spacing: -0.34px;
}

/* Manual mode: drag handle (left) - click and drag here to move the score */
.character-creation-rolled-score-drag-handle {
    width: 12px;
    min-width: 12px;
    height: 100%;
    background-color: var(--color-bg-shade1);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: 2px 0 0 2px;
    justify-content: center;
    align-items: center;
    align-self: stretch;
}

.character-creation-rolled-score-drag-handle:hover {
    background-color: var(--color-border-default);
}

.character-creation-rolled-score-drag-handle-icon {
    color: var(--color-text-n3);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* Manual mode: TextField (right) - click here to type; gray caret for visibility */
.character-creation-rolled-score-item TextField.character-creation-rolled-score-value {
    flex-grow: 1;
    width: 100%;
    min-width: 28px;
    min-height: 28px;
    -unity-text-align: middle-center;
    border-width: 0;
    border-color: transparent;
    padding: 4px 3px;
    background-color: transparent;
    --unity-cursor-color: rgba(180, 180, 180, 1);
}

.character-creation-rolled-score-item TextField.character-creation-rolled-score-value .unity-text-field__input {
    -unity-text-align: middle-center;
    border-width: 0;
    border-color: transparent;
    background-color: transparent;
    min-width: 24px;
    padding: 2px 0;
}

/* Drop Zone Styles */
.character-creation-ability-stat-row.drag-over {
    border-color: var(--color-blue);
    border-width: 2px;
    background-color: var(--color-bg-shade1);
}

.character-creation-ability-stat-row.unassigned .character-creation-ability-score-value {
    color: var(--color-text-n4);
}

.character-creation-subtitle {
    color: var(--color-text-n2);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 12px;
    margin-top: 16px;
    letter-spacing: -0.3px;
}

/* Two explicit rows (3 + 3); equal-width tiles; inner score row uses % columns so three tiles always fit panel width (no horizontal scroll). */
.character-creation-ability-scores-grid {
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 16px;
    min-width: 0;
    width: 100%;
    overflow: hidden;
}

/* class name must match AbilityScoresGridTraversal.RowHostUssClass (C#) */
.character-creation-ability-scores-row {
    flex-direction: row;
    flex-wrap: nowrap;
    align-content: stretch;
    align-items: stretch;
    flex-grow: 0;
    width: 100%;
    min-width: 0;
    justify-content: center;
}

/* USS does not support the + sibling combinator */
.character-creation-ability-scores-row--second {
    margin-top: 8px;
    justify-content: center;
}

/* Equal columns; min-width 0 so flex can shrink — intrinsic layout comes from fluid % score/mod band inside each tile. */
.character-creation-ability-scores-row > .character-creation-ability-stat-row {
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 8px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: auto;
    max-width: none;
}

.character-creation-ability-scores-tile--row-end {
    margin-right: 0;
}

.character-creation-ability-stat-row {
    background-color: var(--color-bg-shade1);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-default);
    padding: 10px;
    flex-direction: column;
    justify-content: center;
    align-items: stretch;
    min-width: 0;
    flex-shrink: 1;
    width: 100%;
}

.character-creation-ability-stat-name {
    color: var(--color-blue);
    font-size: 14px;
    -unity-font-style: bold;
    width: 100%;
    flex-shrink: 0;
    margin: 0;
    padding: 0 0 8px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    letter-spacing: -0.3px;
    -unity-text-align: middle-center;
}

.character-creation-ability-stat-values {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    width: 100%;
    margin: 8px 0 0 0;
    padding: 0;
}

.character-creation-ability-stat-inline-block {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    flex-shrink: 1;
    flex-grow: 0;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    align-self: stretch;
    margin: 0;
    padding: 0;
}

.character-creation-ability-stat-inline-label-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-start;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    margin: 0 0 6px 0;
    padding: 0;
}

/* Equal halves: “Score” centered over left column, “Mod” over right. */
.character-creation-ability-stat-header-track--score {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: auto;
    margin-right: 0;
}

.character-creation-ability-stat-header-track--mod {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    width: auto;
}

.character-creation-ability-stat-column {
    align-items: center;
}

.character-creation-ability-stat-label {
    font-size: 10px;
    color: var(--color-text-n4);
    margin: 0 0 4px 0;
    letter-spacing: 0.4px;
    -unity-font-style: normal;
    /* Same vertical slot for “Score” / “Mod” so headers line up across columns */
    min-height: 14px;
    max-height: 14px;
    -unity-text-align: middle-center;
    width: 100%;
}

/* Ability Score Drop Zone */
.character-creation-ability-score-drop-zone {
    width: 100%;
    min-width: 0;
    max-width: none;
    flex-shrink: 0;
    height: 100%;
    min-height: 26px;
    border-width: 2px;
    border-color: var(--color-border-subtle);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-shade1);
    justify-content: center;
    align-items: center;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color;
}

.character-creation-ability-stat-row.unassigned .character-creation-ability-score-drop-zone {
    border-color: var(--color-border-subtle);
    background-color: var(--color-bg-shade1);
}

.character-creation-ability-stat-row.drag-over .character-creation-ability-score-drop-zone {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
}

.character-creation-ability-stat-row.assigned .character-creation-ability-score-drop-zone {
    border-color: var(--color-border-default);
    background-color: var(--color-bg-primary);
}

/* Manual mode: direct numeric entry in place of the drop zone */
.character-creation-ability-score-entry-field {
    width: 100%;
    min-width: 0;
    max-width: none;
    flex-shrink: 0;
    min-height: 26px;
    height: 100%;
    margin-left: 0;
    margin-right: 0;
    padding: 0;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-primary);
    --unity-cursor-color: rgba(180, 180, 180, 1);
}

.character-creation-ability-stat-row.unassigned .character-creation-ability-score-entry-field {
    border-color: var(--color-border-subtle);
    background-color: var(--color-bg-shade1);
}

.character-creation-ability-stat-row.unassigned .character-creation-ability-mod-box {
    border-color: var(--color-border-subtle);
    background-color: var(--color-bg-shade1);
}

.character-creation-ability-stat-row.assigned .character-creation-ability-mod-box {
    border-color: var(--color-border-default);
    background-color: var(--color-bg-primary);
}

.character-creation-ability-score-entry-field .unity-text-field__input {
    -unity-text-align: middle-center;
    min-height: 22px;
    font-size: 15px;
    -unity-font-style: bold;
    border-width: 0;
    background-color: transparent;
    padding: 4px 2px;
    color: var(--color-text-primary);
}

/* Ability Score Label in stat rows */
.character-creation-ability-score-value {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    letter-spacing: -0.34px;
    -unity-text-align: middle-center;
}

.character-creation-ability-score-value.increased {
    color: #4caf50; /* Green for positive changes */
}

.character-creation-ability-score-value.decreased {
    color: var(--color-red); /* Red for negative changes */
}

.character-creation-ability-modifier-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text-n3); /* Neutral grey for dash / unassigned */
    letter-spacing: -0.3px;
}

/* Modifier in same row as score; width comes from value-row flex rule when nested there. */
.character-creation-ability-mod-box {
    min-width: 0;
    min-height: 26px;
    flex-shrink: 1;
    border-width: 2px;
    border-color: var(--color-border-default);
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-shade1);
    justify-content: center;
    align-items: center;
}

.character-creation-ability-mod-box > .character-creation-ability-modifier-value {
    min-height: auto;
    margin-bottom: 0;
    -unity-text-align: middle-center;
}

.character-creation-ability-modifier-value.character-creation-ability-mod-positive {
    color: #4caf50; /* Green for positive modifiers */
}

.character-creation-ability-modifier-value.character-creation-ability-mod-neutral {
    color: var(--color-text-n3); /* Grey for zero or dash */
}

.character-creation-ability-modifier-value.negative {
    color: var(--color-red); /* Red for negative modifiers */
}

.character-creation-change-indicator {
    font-size: 16px;
    -unity-font-style: bold;
    margin-left: 5px;
}

.character-creation-change-indicator.increase {
    color: #4caf50; /* Green for increases */
}

.character-creation-change-indicator.decrease {
    color: var(--color-red); /* Red for decreases */
}

/* Character Stats Grid */
.character-creation-character-stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 14px;
}

.character-creation-character-stats-grid > * {
    margin-right: 8px;
    margin-bottom: 8px;
}

.character-creation-char-stat-item {
    background-color: var(--color-bg-shade1);
    border-radius: var(--radius-sm);
    border-width: 1px;
    border-color: var(--color-border-default);
    padding: 10px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-width: 120px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 160px;
    max-width: 340px;
}

.character-creation-char-stat-label {
    color: var(--color-text-n3);
    font-size: 13px;
    letter-spacing: -0.26px;
}

.character-creation-char-stat-value {
    color: var(--color-text-primary);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: -0.28px;
}

/* Modifier-type stats (Initiative, Proficiency, Spell Attack): green / grey / red */
.character-creation-char-stat-value.character-creation-char-stat-modifier.character-creation-char-stat-positive {
    color: #4caf50;
}

.character-creation-char-stat-value.character-creation-char-stat-modifier.character-creation-char-stat-neutral {
    color: var(--color-text-n3);
}

.character-creation-char-stat-value.character-creation-char-stat-modifier.character-creation-char-stat-negative {
    color: var(--color-red);
}

/* ~35% of right column */
.character-creation-proficiency-panel {
    background-color: var(--color-bg-secondary);
    border-width: 1px;
    border-color: var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 30px;
    flex-direction: column;
    flex-grow: 7;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: 0;
}

.character-creation-proficiency-title {
    flex-shrink: 0;
    color: var(--color-blue);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-subtle);
    padding-bottom: 12px;
    letter-spacing: -0.8px;
}

.character-creation-proficiency-list-host {
    flex-direction: column;
    flex-grow: 0;
}

.character-creation-proficiency-placeholder {
    color: var(--color-text-n3);
    font-size: 14px;
    white-space: normal;
    letter-spacing: -0.28px;
}

.character-creation-proficiency-category {
    margin-bottom: 20px;
}

.character-creation-proficiency-category-title {
    font-size: 15px;
    color: var(--color-text-n2);
    margin-bottom: 12px;
    -unity-font-style: bold;
    letter-spacing: -0.3px;
}

.character-creation-proficiency-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.character-creation-proficiency-list > * {
    margin-right: 10px;
    margin-bottom: 10px;
}

.character-creation-proficiency-tag {
    background-color: var(--color-bg-shade1);
    border-width: 1px;
    border-color: var(--color-blue);
    border-radius: var(--radius-sm);
    padding: 8px 14px;
    font-size: 14px;
    color: var(--color-text-n1);
    flex-direction: row;
    align-items: center;
    letter-spacing: -0.28px;
}

.character-creation-proficiency-tag > * {
    margin-right: 8px;
    color: var(--color-text-n1);
}

.character-creation-proficiency-tag .source {
    font-size: 11px;
    color: var(--color-text-n3);
    opacity: 0.8;
    margin-right: 0;
}

/* Action Buttons - fixed at bottom, outside scroll */
.character-creation-action-buttons {
    flex-direction: row;
    justify-content: flex-end;
    flex-shrink: 0;
    padding: 20px;
    border-top-width: 1px;
    border-top-color: var(--color-border-subtle);
    background-color: var(--color-bg-primary);
}

.character-creation-action-buttons > * {
    margin-right: var(--spacing-sm);
}

.character-creation-cancel-button {
    background-color: var(--color-bg-secondary);
    border-width: 2px;
    border-color: var(--color-border-default);
    color: var(--color-text-secondary);
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: -0.28px;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color, color;
}

.character-creation-cancel-button:hover {
    border-color: var(--color-text-n3);
    background-color: var(--color-bg-shade1);
    color: var(--color-text-primary);
}

.character-creation-create-button {
    background-color: var(--color-bg-secondary);
    border-width: 2px;
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
    padding: 10px 24px;
    border-radius: var(--radius-sm);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: -0.28px;
    transition-duration: var(--transition-fast);
    transition-property: border-color, background-color;
}

.character-creation-create-button:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-shade1);
}
